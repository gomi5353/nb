# Object position coverage spec (template).
#
# You decide what "enough coverage" means for your dataset. Fill in every
# "TODO" below, then run:
#
#   uv run python scripts/verify_object_position_coverage.py check \
#       --dataset <your dataset> --spec <this file>
#
# Guide: docs/object_position_coverage.md
#
# Units and frame: metres, env-local frame (the same frame as the
# object_position.<name> dataset columns and the task cfg's init_state.pos).
#
# One block per object you want checked. Delete a block to stop checking that
# object; copy a block to check another one. Objects without a block are
# recorded but never checked.

@prefix cp:   <http://taica.course/cp/ontology#> .
@prefix spec: <http://taica.course/cp/spec/mine#> .

# The object position axis. Each block below adds one requirement to it.
spec:object_position_axis a cp:ObjectPositionAxis .

# --- BEGIN OBJECT ---
spec:object_position_axis cp:hasRequirement spec:OBJECT_NAME_requirement .

spec:OBJECT_NAME_requirement a cp:ObjectPositionAxisRequirement ;
    cp:hasTaskObject spec:OBJECT_NAME ;
    cp:hasAreaConfiguration spec:OBJECT_NAME_area ;

    # Minimum number of episodes whose initial position of this object falls
    # inside each cell. Whole number, e.g. 2.
    cp:minEpisodesPerCell "TODO" .

spec:OBJECT_NAME a cp:TaskObject ;
    # Must match the dataset column name object_position.OBJECT_NAME.
    cp:hasName [ a cp:Name ; cp:nameValue "OBJECT_NAME" ] .

spec:OBJECT_NAME_area a cp:AreaConfiguration ;
    cp:hasCoverageGrid spec:OBJECT_NAME_grid ;

    # Rectangle your data should cover: where this object may start.
    # Numbers, e.g. 8.80 (not quoted).
    cp:areaXMin "TODO" ; cp:areaXMax "TODO" ;
    cp:areaYMin "TODO" ; cp:areaYMax "TODO" .

spec:OBJECT_NAME_grid a cp:CoverageGrid ;
    # Number of cells along x (width) and along y (height).
    # Cell width = (areaXMax - areaXMin) / numCellW. Whole numbers, e.g. 3.
    cp:numCellW "TODO" ; cp:numCellH "TODO" .
# --- END OBJECT ---
