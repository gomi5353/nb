# OWL vocabulary for object pose coverage verification.
#
# Read as: a Dataset has Episodes; each Episode has one initial ObjectPlacement
# per TaskObject (the object's pose in the episode's first frame). A task spec
# declares CoverageRequirements: a workspace rectangle for one object, split
# into a grid of CoverageCells, each of which needs a minimum number of
# episodes whose initial placement falls inside it.
#
# The requirement is tagged with the generalization axis it targets, following
# STAR-Gen, "A Taxonomy for Evaluating Generalist Robot Manipulation Policies"
# (https://stargen-taxonomy.github.io/), where Object Pose (POSE) is one axis.

@prefix cp:      <http://taica.course/cp/ontology#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix vann:    <http://purl.org/vocab/vann/> .

<http://taica.course/cp/ontology> a owl:Ontology ;
    dcterms:title "Course project object pose coverage ontology"@en ;
    owl:versionIRI <http://taica.course/cp/ontology/1.0.0> ;
    vann:preferredNamespacePrefix "cp" ;
    vann:preferredNamespaceUri "http://taica.course/cp/ontology#" .

# ---- Classes ----------------------------------------------------------------

cp:Dataset a owl:Class ;
    rdfs:comment "A LeRobot dataset under verification."@en .

cp:Episode a owl:Class ;
    rdfs:comment "One recorded episode, successful or failed."@en .

cp:TaskObject a owl:Class ;
    rdfs:comment "A scene rigid object, identified by its IsaacLab scene name."@en .

cp:ObjectPlacement a owl:Class ;
    rdfs:comment "Initial pose of one TaskObject in one Episode (first recorded frame), env-local frame, metres."@en .

cp:WorkspaceRegion a owl:Class ;
    rdfs:comment "Axis-aligned xy rectangle in the env-local frame."@en .

cp:CoverageRequirement a owl:Class ;
    rdfs:subClassOf cp:WorkspaceRegion ;
    rdfs:comment "Region an object's initial placements must cover, with a grid resolution and a minimum count per cell."@en .

cp:CoverageCell a owl:Class ;
    rdfs:subClassOf cp:WorkspaceRegion ;
    rdfs:comment "One grid cell of a CoverageRequirement. Generated by the verifier from the requirement's grid."@en .

cp:GeneralizationAxis a owl:Class ;
    rdfs:comment "An axis of the STAR-Gen generalization taxonomy."@en .

cp:ObjectPoseAxis a cp:GeneralizationAxis ;
    rdfs:label "Object Pose (POSE)"@en ;
    rdfs:seeAlso <https://stargen-taxonomy.github.io/> .

# ---- Object properties --------------------------------------------------------

cp:hasEpisode a owl:ObjectProperty ;
    rdfs:domain cp:Dataset ; rdfs:range cp:Episode .

cp:hasInitialPlacement a owl:ObjectProperty ;
    rdfs:domain cp:Episode ; rdfs:range cp:ObjectPlacement .

cp:ofObject a owl:ObjectProperty ;
    rdfs:domain cp:ObjectPlacement ; rdfs:range cp:TaskObject .

cp:forObject a owl:ObjectProperty ;
    rdfs:domain cp:CoverageRequirement ; rdfs:range cp:TaskObject .

cp:targetsAxis a owl:ObjectProperty ;
    rdfs:domain cp:CoverageRequirement ; rdfs:range cp:GeneralizationAxis .

cp:ofRequirement a owl:ObjectProperty ;
    rdfs:domain cp:CoverageCell ; rdfs:range cp:CoverageRequirement .

# ---- Datatype properties ------------------------------------------------------

cp:episodeIndex a owl:DatatypeProperty ; rdfs:domain cp:Episode ; rdfs:range xsd:integer .
cp:objectName a owl:DatatypeProperty ; rdfs:domain cp:TaskObject ; rdfs:range xsd:string .
cp:taskName a owl:DatatypeProperty ; rdfs:range xsd:string .

cp:x a owl:DatatypeProperty ; rdfs:domain cp:ObjectPlacement ; rdfs:range xsd:double .
cp:y a owl:DatatypeProperty ; rdfs:domain cp:ObjectPlacement ; rdfs:range xsd:double .
cp:z a owl:DatatypeProperty ; rdfs:domain cp:ObjectPlacement ; rdfs:range xsd:double .

cp:xMin a owl:DatatypeProperty ; rdfs:domain cp:WorkspaceRegion ; rdfs:range xsd:decimal .
cp:xMax a owl:DatatypeProperty ; rdfs:domain cp:WorkspaceRegion ; rdfs:range xsd:decimal .
cp:yMin a owl:DatatypeProperty ; rdfs:domain cp:WorkspaceRegion ; rdfs:range xsd:decimal .
cp:yMax a owl:DatatypeProperty ; rdfs:domain cp:WorkspaceRegion ; rdfs:range xsd:decimal .

cp:gridX a owl:DatatypeProperty ; rdfs:domain cp:CoverageRequirement ; rdfs:range xsd:positiveInteger .
cp:gridY a owl:DatatypeProperty ; rdfs:domain cp:CoverageRequirement ; rdfs:range xsd:positiveInteger .
cp:minEpisodesPerCell a owl:DatatypeProperty ; rdfs:domain cp:CoverageRequirement ; rdfs:range xsd:nonNegativeInteger .

cp:cellI a owl:DatatypeProperty ; rdfs:domain cp:CoverageCell ; rdfs:range xsd:integer ;
    rdfs:comment "Column index along x, 0 at xMin."@en .
cp:cellJ a owl:DatatypeProperty ; rdfs:domain cp:CoverageCell ; rdfs:range xsd:integer ;
    rdfs:comment "Row index along y, 0 at yMin."@en .
cp:xMaxInclusive a owl:DatatypeProperty ; rdfs:domain cp:CoverageCell ; rdfs:range xsd:boolean ;
    rdfs:comment "True for the last column, so the requirement's upper x edge belongs to a cell."@en .
cp:yMaxInclusive a owl:DatatypeProperty ; rdfs:domain cp:CoverageCell ; rdfs:range xsd:boolean .
