# OWL vocabulary for object pose coverage verification.
#
# Read as: a Dataset has Episodes; each Episode has one initial ObjectPlacement
# per TaskObject (the object's pose in the episode's first frame). A task spec
# declares CoverageRequirements: a workspace rectangle for one object, split
# into a grid of CoverageCells, each of which needs a minimum number of
# episodes whose initial placement falls inside it.
#
# The requirement is tagged with the generalization axis it targets, following
# STAR-Gen, "A Taxonomy for Evaluating Generalist Robot Manipulation Policies"
# (https://stargen-taxonomy.github.io/), where Object Pose (POSE) is one axis.

@prefix dv:   <urn:aicapstone:dv#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

dv:ObjectPoseCoverageOntology a owl:Ontology ;
    rdfs:label "Object pose coverage ontology"@en .

# ---- Classes ----------------------------------------------------------------

dv:Dataset a owl:Class ;
    rdfs:comment "A LeRobot dataset under verification."@en .

dv:Episode a owl:Class ;
    rdfs:comment "One recorded episode, successful or failed."@en .

dv:TaskObject a owl:Class ;
    rdfs:comment "A scene rigid object, identified by its IsaacLab scene name."@en .

dv:ObjectPlacement a owl:Class ;
    rdfs:comment "Initial pose of one TaskObject in one Episode (first recorded frame), env-local frame, metres."@en .

dv:WorkspaceRegion a owl:Class ;
    rdfs:comment "Axis-aligned xy rectangle in the env-local frame."@en .

dv:CoverageRequirement a owl:Class ;
    rdfs:subClassOf dv:WorkspaceRegion ;
    rdfs:comment "Region an object's initial placements must cover, with a grid resolution and a minimum count per cell."@en .

dv:CoverageCell a owl:Class ;
    rdfs:subClassOf dv:WorkspaceRegion ;
    rdfs:comment "One grid cell of a CoverageRequirement. Generated by the verifier from the requirement's grid."@en .

dv:GeneralizationAxis a owl:Class ;
    rdfs:comment "An axis of the STAR-Gen generalization taxonomy."@en .

dv:ObjectPoseAxis a dv:GeneralizationAxis ;
    rdfs:label "Object Pose (POSE)"@en ;
    rdfs:seeAlso <https://stargen-taxonomy.github.io/> .

# ---- Object properties --------------------------------------------------------

dv:hasEpisode a owl:ObjectProperty ;
    rdfs:domain dv:Dataset ; rdfs:range dv:Episode .

dv:hasInitialPlacement a owl:ObjectProperty ;
    rdfs:domain dv:Episode ; rdfs:range dv:ObjectPlacement .

dv:ofObject a owl:ObjectProperty ;
    rdfs:domain dv:ObjectPlacement ; rdfs:range dv:TaskObject .

dv:forObject a owl:ObjectProperty ;
    rdfs:domain dv:CoverageRequirement ; rdfs:range dv:TaskObject .

dv:targetsAxis a owl:ObjectProperty ;
    rdfs:domain dv:CoverageRequirement ; rdfs:range dv:GeneralizationAxis .

dv:ofRequirement a owl:ObjectProperty ;
    rdfs:domain dv:CoverageCell ; rdfs:range dv:CoverageRequirement .

# ---- Datatype properties ------------------------------------------------------

dv:episodeIndex a owl:DatatypeProperty ; rdfs:domain dv:Episode ; rdfs:range xsd:integer .
dv:objectName a owl:DatatypeProperty ; rdfs:domain dv:TaskObject ; rdfs:range xsd:string .
dv:taskName a owl:DatatypeProperty ; rdfs:range xsd:string .

dv:x a owl:DatatypeProperty ; rdfs:domain dv:ObjectPlacement ; rdfs:range xsd:double .
dv:y a owl:DatatypeProperty ; rdfs:domain dv:ObjectPlacement ; rdfs:range xsd:double .
dv:z a owl:DatatypeProperty ; rdfs:domain dv:ObjectPlacement ; rdfs:range xsd:double .

dv:xMin a owl:DatatypeProperty ; rdfs:domain dv:WorkspaceRegion ; rdfs:range xsd:decimal .
dv:xMax a owl:DatatypeProperty ; rdfs:domain dv:WorkspaceRegion ; rdfs:range xsd:decimal .
dv:yMin a owl:DatatypeProperty ; rdfs:domain dv:WorkspaceRegion ; rdfs:range xsd:decimal .
dv:yMax a owl:DatatypeProperty ; rdfs:domain dv:WorkspaceRegion ; rdfs:range xsd:decimal .

dv:gridX a owl:DatatypeProperty ; rdfs:domain dv:CoverageRequirement ; rdfs:range xsd:positiveInteger .
dv:gridY a owl:DatatypeProperty ; rdfs:domain dv:CoverageRequirement ; rdfs:range xsd:positiveInteger .
dv:minEpisodesPerCell a owl:DatatypeProperty ; rdfs:domain dv:CoverageRequirement ; rdfs:range xsd:nonNegativeInteger .

dv:cellI a owl:DatatypeProperty ; rdfs:domain dv:CoverageCell ; rdfs:range xsd:integer ;
    rdfs:comment "Column index along x, 0 at xMin."@en .
dv:cellJ a owl:DatatypeProperty ; rdfs:domain dv:CoverageCell ; rdfs:range xsd:integer ;
    rdfs:comment "Row index along y, 0 at yMin."@en .
dv:xMaxInclusive a owl:DatatypeProperty ; rdfs:domain dv:CoverageCell ; rdfs:range xsd:boolean ;
    rdfs:comment "True for the last column, so the requirement's upper x edge belongs to a cell."@en .
dv:yMaxInclusive a owl:DatatypeProperty ; rdfs:domain dv:CoverageCell ; rdfs:range xsd:boolean .
