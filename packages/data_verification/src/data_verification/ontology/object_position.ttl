# OWL vocabulary for object position coverage verification.
#
# Read as: an ObjectPositionAxis has a Dataset and ObjectPositionAxisRequirements.
# The Dataset has Episodes (each with an Index); each Episode has TaskObjects
# (each with a Name and its initial Position: first recorded frame, env-local
# frame, metres). A requirement names one TaskObject and an AreaConfiguration
# whose CoverageGrid splits the area into Cells; every Cell needs at least
# minEpisodesPerCell episodes whose initial position of that object falls
# inside it. Requirement and episode objects are matched by name.

@prefix cp:      <http://taica.course/cp/ontology#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix vann:    <http://purl.org/vocab/vann/> .

<http://taica.course/cp/ontology> a owl:Ontology ;
    dcterms:title "Course project object position coverage ontology"@en ;
    owl:versionIRI <http://taica.course/cp/ontology/2.0.0> ;
    vann:preferredNamespacePrefix "cp" ;
    vann:preferredNamespaceUri "http://taica.course/cp/ontology#" .

# ---- Classes ----------------------------------------------------------------

cp:GeneralizationAxis a owl:Class ;
    rdfs:label "Generalization Axis"@en ;
    rdfs:comment "A dimension along which a robot manipulation system is expected to generalize."@en .

cp:ObjectPositionAxis a owl:Class ;
    rdfs:subClassOf cp:GeneralizationAxis ;
    rdfs:label "Object Position Axis"@en ;
    rdfs:comment "A generalization axis concerned with variations in object positions."@en .

cp:AxisRequirement a owl:Class ;
    rdfs:label "Axis Requirement"@en ;
    rdfs:comment "A coverage requirement along one generalization axis. Each axis subclasses it with its own requirement class."@en .

cp:ObjectPositionAxisRequirement a owl:Class ;
    rdfs:subClassOf cp:AxisRequirement ;
    rdfs:label "Object Position Axis Requirement"@en ;
    rdfs:comment "A coverage requirement specifying the task object, the object-position area and the required episode coverage."@en .

cp:Dataset a owl:Class ;
    rdfs:label "Dataset"@en ;
    rdfs:comment "A collection of recorded robot-learning episodes (a LeRobot dataset under verification)."@en .

cp:Episode a owl:Class ;
    rdfs:label "Episode"@en ;
    rdfs:comment "A recorded execution or demonstration belonging to a dataset."@en .

cp:Index a owl:Class ;
    rdfs:label "Index"@en ;
    rdfs:comment "An integer index. For an Episode: its LeRobot episode_index. For a Cell: the row-major cell number k = j * numCellW + i, with column i along X from areaXMin and row j along Y from areaYMin."@en .

cp:TaskObject a owl:Class ;
    rdfs:label "Task Object"@en ;
    rdfs:comment "An object relevant to the task and whose position is tracked. Pointed to by a requirement (the object to check) and by each Episode (the object in that episode, with its initial position)."@en .

cp:Name a owl:Class ;
    rdfs:label "Name"@en ;
    rdfs:comment "The name of a task object: its IsaacLab scene name, as in the dataset column object_position.<name>."@en .

cp:Position a owl:Class ;
    rdfs:label "Position"@en ;
    rdfs:comment "A spatial position represented in the coordinate frame selected by the dataset or task configuration (env-local frame, metres)."@en .

cp:AreaConfiguration a owl:Class ;
    rdfs:label "Area Configuration"@en ;
    rdfs:comment "The whole rectangular area in which object positions are considered for coverage."@en .

cp:CoverageGrid a owl:Class ;
    rdfs:label "Coverage Grid"@en ;
    rdfs:comment "A rectangular grid that partitions an area configuration into cells. A grid with numCellW columns and numCellH rows contains numCellW * numCellH cells; checked with SHACL."@en .

cp:Cell a owl:Class ;
    rdfs:label "Coverage Cell"@en ;
    rdfs:comment "One subregion of the whole rectangular area, identified by its Index. Its bounds follow from the area, the grid and the index. The minimum episode count is minEpisodesPerCell on the associated requirement and applies to every cell. Generated by the verifier."@en .

# ---- Object properties --------------------------------------------------------

cp:hasDataset a owl:ObjectProperty ;
    rdfs:domain cp:GeneralizationAxis ;
    rdfs:range cp:Dataset ;
    rdfs:label "has dataset"@en .

cp:hasRequirement a owl:ObjectProperty ;
    rdfs:domain cp:GeneralizationAxis ;
    rdfs:range cp:AxisRequirement ;
    rdfs:label "has requirement"@en .

cp:hasEpisode a owl:ObjectProperty ;
    rdfs:domain cp:Dataset ;
    rdfs:range cp:Episode ;
    rdfs:label "has episode"@en .

cp:hasIndex a owl:ObjectProperty ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( cp:Episode cp:Cell ) ] ;
    rdfs:range cp:Index ;
    rdfs:label "has index"@en .

cp:hasTaskObject a owl:ObjectProperty ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( cp:Episode cp:ObjectPositionAxisRequirement ) ] ;
    rdfs:range cp:TaskObject ;
    rdfs:label "has task object"@en .

cp:hasName a owl:ObjectProperty ;
    rdfs:domain cp:TaskObject ;
    rdfs:range cp:Name ;
    rdfs:label "has name"@en .

cp:hasPosition a owl:ObjectProperty ;
    rdfs:domain cp:TaskObject ;
    rdfs:range cp:Position ;
    rdfs:label "has position"@en .

cp:hasAreaConfiguration a owl:ObjectProperty ;
    rdfs:domain cp:ObjectPositionAxisRequirement ;
    rdfs:range cp:AreaConfiguration ;
    rdfs:label "has area configuration"@en .

cp:hasCoverageGrid a owl:ObjectProperty ;
    rdfs:domain cp:AreaConfiguration ;
    rdfs:range cp:CoverageGrid ;
    rdfs:label "has coverage grid"@en .

cp:hasCell a owl:ObjectProperty ;
    rdfs:domain cp:CoverageGrid ;
    rdfs:range cp:Cell ;
    rdfs:label "has cell"@en .

# ---- Datatype properties ------------------------------------------------------

cp:indexValue a owl:DatatypeProperty ;
    rdfs:domain cp:Index ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:label "index value"@en .

cp:nameValue a owl:DatatypeProperty ;
    rdfs:domain cp:Name ;
    rdfs:range xsd:string ;
    rdfs:label "name value"@en .

cp:positionX a owl:DatatypeProperty ;
    rdfs:domain cp:Position ;
    rdfs:range xsd:decimal ;
    rdfs:label "position X"@en .

cp:positionY a owl:DatatypeProperty ;
    rdfs:domain cp:Position ;
    rdfs:range xsd:decimal ;
    rdfs:label "position Y"@en .

cp:minEpisodesPerCell a owl:DatatypeProperty ;
    rdfs:domain cp:ObjectPositionAxisRequirement ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:label "minimum episodes per cell"@en ;
    rdfs:comment "The minimum number of episodes required to cover each cell in the grid."@en .

cp:areaXMin a owl:DatatypeProperty ;
    rdfs:domain cp:AreaConfiguration ;
    rdfs:range xsd:decimal ;
    rdfs:label "area X minimum"@en .

cp:areaXMax a owl:DatatypeProperty ;
    rdfs:domain cp:AreaConfiguration ;
    rdfs:range xsd:decimal ;
    rdfs:label "area X maximum"@en .

cp:areaYMin a owl:DatatypeProperty ;
    rdfs:domain cp:AreaConfiguration ;
    rdfs:range xsd:decimal ;
    rdfs:label "area Y minimum"@en .

cp:areaYMax a owl:DatatypeProperty ;
    rdfs:domain cp:AreaConfiguration ;
    rdfs:range xsd:decimal ;
    rdfs:label "area Y maximum"@en .

cp:numCellW a owl:DatatypeProperty ;
    rdfs:domain cp:CoverageGrid ;
    rdfs:range xsd:positiveInteger ;
    rdfs:label "number of cells in width"@en ;
    rdfs:comment "The number of grid divisions along the width (X direction)."@en .

cp:numCellH a owl:DatatypeProperty ;
    rdfs:domain cp:CoverageGrid ;
    rdfs:range xsd:positiveInteger ;
    rdfs:label "number of cells in height"@en ;
    rdfs:comment "The number of grid divisions along the height (Y direction)."@en .
