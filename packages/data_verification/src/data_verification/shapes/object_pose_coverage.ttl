# SHACL rules for object pose coverage.
#
# Severity:
#   sh:Violation - dataset fails verification (malformed data, uncovered cell)
#   sh:Warning   - reported, does not fail unless --strict (placement outside
#                  the required region: allowed, it just does not count)
#
# All episodes count toward coverage, whether the recorded attempt succeeded
# or failed: coverage is about which initial scenes the data shows.

@prefix cp:   <http://taica.course/cp/ontology#> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .

cp: a owl:Ontology ;
    sh:declare [ sh:prefix "cp" ; sh:namespace "http://taica.course/cp/ontology#"^^xsd:anyURI ] .

# ---- Episode: one initial placement per required object ---------------------

cp:EpisodeShape a sh:NodeShape ;
    sh:targetClass cp:Episode ;
    sh:property [
        sh:path cp:episodeIndex ;
        sh:datatype xsd:integer ; sh:minCount 1 ; sh:maxCount 1 ;
    ] ;
    sh:sparql [
        sh:message "Episode has no initial pose for required object '{?name}'" ;
        sh:prefixes cp: ;
        sh:select """
            SELECT $this ?name WHERE {
                ?req a cp:CoverageRequirement ; cp:forObject ?obj .
                ?obj cp:objectName ?name .
                FILTER NOT EXISTS { $this cp:hasInitialPlacement ?p . ?p cp:ofObject ?obj . }
            }
        """ ;
    ] ;
    sh:sparql [
        sh:message "Episode has more than one initial pose for object '{?name}'" ;
        sh:prefixes cp: ;
        sh:select """
            SELECT $this ?name WHERE {
                $this cp:hasInitialPlacement ?p1, ?p2 .
                ?p1 cp:ofObject ?obj . ?p2 cp:ofObject ?obj .
                ?obj cp:objectName ?name .
                FILTER (STR(?p1) < STR(?p2))
            }
        """ ;
    ] .

# ---- Placement: well-formed numbers, inside the required region -------------

cp:ObjectPlacementShape a sh:NodeShape ;
    sh:targetClass cp:ObjectPlacement ;
    sh:property [ sh:path cp:ofObject ; sh:class cp:TaskObject ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path cp:x ; sh:datatype xsd:double ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path cp:y ; sh:datatype xsd:double ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path cp:z ; sh:datatype xsd:double ; sh:minCount 1 ; sh:maxCount 1 ] .

# Severity is a property of the shape, so the region check gets its own shape.
cp:ObjectPlacementRegionShape a sh:NodeShape ;
    sh:targetClass cp:ObjectPlacement ;
    sh:severity sh:Warning ;
    sh:sparql [
        sh:message "Initial pose of '{?name}' at ({?x}, {?y}) is outside the required region; it does not count toward coverage" ;
        sh:prefixes cp: ;
        sh:select """
            SELECT $this ?name ?x ?y WHERE {
                $this cp:ofObject ?obj ; cp:x ?x ; cp:y ?y .
                ?obj cp:objectName ?name .
                ?req a cp:CoverageRequirement ; cp:forObject ?obj ;
                     cp:xMin ?x0 ; cp:xMax ?x1 ; cp:yMin ?y0 ; cp:yMax ?y1 .
                FILTER (?x < ?x0 || ?x > ?x1 || ?y < ?y0 || ?y > ?y1)
            }
        """ ;
    ] .

# ---- Requirement: well-formed spec ------------------------------------------

cp:CoverageRequirementShape a sh:NodeShape ;
    sh:targetClass cp:CoverageRequirement ;
    sh:property [ sh:path cp:forObject ; sh:class cp:TaskObject ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path cp:targetsAxis ; sh:hasValue cp:ObjectPoseAxis ] ;
    sh:property [ sh:path cp:xMin ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path cp:xMax ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path cp:yMin ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path cp:yMax ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path cp:gridX ; sh:minCount 1 ; sh:maxCount 1 ; sh:minInclusive 1 ] ;
    sh:property [ sh:path cp:gridY ; sh:minCount 1 ; sh:maxCount 1 ; sh:minInclusive 1 ] ;
    sh:property [ sh:path cp:minEpisodesPerCell ; sh:minCount 1 ; sh:maxCount 1 ; sh:minInclusive 0 ] ;
    sh:sparql [
        sh:message "Coverage region is empty: xMin must be < xMax and yMin < yMax" ;
        sh:prefixes cp: ;
        sh:select """
            SELECT $this WHERE {
                $this cp:xMin ?x0 ; cp:xMax ?x1 ; cp:yMin ?y0 ; cp:yMax ?y1 .
                FILTER (?x0 >= ?x1 || ?y0 >= ?y1)
            }
        """ ;
    ] .

# ---- Cell: the coverage rule itself -----------------------------------------
# A placement is in a cell when xMin <= x < xMax (<= xMax on the last column),
# same for y. Cells with fewer placements than minEpisodesPerCell fail.

cp:CoverageCellShape a sh:NodeShape ;
    sh:targetClass cp:CoverageCell ;
    sh:sparql [
        sh:message "'{?name}' cell (i={?i}, j={?j}) x=[{?x0}, {?x1}] y=[{?y0}, {?y1}] has {?n} episode(s); needs at least {?min}" ;
        sh:prefixes cp: ;
        sh:select """
            SELECT $this ?name ?i ?j ?x0 ?x1 ?y0 ?y1 ?min (COUNT(DISTINCT ?p) AS ?n) WHERE {
                $this cp:ofRequirement ?req ; cp:cellI ?i ; cp:cellJ ?j ;
                      cp:xMin ?x0 ; cp:xMax ?x1 ; cp:yMin ?y0 ; cp:yMax ?y1 ;
                      cp:xMaxInclusive ?xi ; cp:yMaxInclusive ?yi .
                ?req cp:forObject ?obj ; cp:minEpisodesPerCell ?min .
                ?obj cp:objectName ?name .
                OPTIONAL {
                    ?p cp:ofObject ?obj ; cp:x ?x ; cp:y ?y .
                    FILTER (?x >= ?x0 && (?x < ?x1 || (?xi && ?x = ?x1)) &&
                            ?y >= ?y0 && (?y < ?y1 || (?yi && ?y = ?y1)))
                }
            }
            GROUP BY $this ?name ?i ?j ?x0 ?x1 ?y0 ?y1 ?min
            HAVING (COUNT(DISTINCT ?p) < ?min)
        """ ;
    ] .
